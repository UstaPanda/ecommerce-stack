# Indigo Vault Unified E-Commerce - Environment Variables

# --- REQUIRED: AI SETTINGS ---
# Google Gemini API Key (Required for AI features)
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# --- SECURITY ---
# JWT Secret (Must be the same for Backend and AI)
JWT_SECRET=yahwvg2vqvz33035x26+vmQ9PzfRwdE/EneUx0SHsT4=
JWT_EXPIRATION=900000

# --- DATABASE ---
DB_PASSWORD=password
DB_NAME=ecommerce_analytics
DB_USER=postgres

# --- MAIL SETTINGS (Optional for Email Verification) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=DataPulse <your-email@gmail.com>

# --- GOOGLE OAUTH2 (Optional for Google Login) ---
GOOGLE_OAUTH_CLIENT_ID=your-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# --- NOTE ON FRONTEND KEYS ---
# reCAPTCHA, Stripe, and PayPal keys are located in:
# frontend/src/enviroments/enviroments.ts
# You should update them there before running 'docker-compose up --build'
